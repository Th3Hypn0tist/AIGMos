from __future__ import annotations

import ast
import importlib.util
import inspect
import sys
from pathlib import Path

import pytest

from system.cs.command_def import CommandDef


FORBIDDEN_SOURCE_SNIPPETS = (
    "from system.state import state",
    "state.update(",
    "print(",
)


def _repo_root() -> Path:
    here = Path(__file__).resolve()
    for parent in (here.parent, *here.parents):
        if (parent / "extensions" / "commands").is_dir():
            return parent
    raise RuntimeError("Could not find repo root containing extensions/commands")


REPO_ROOT = _repo_root()
COMMANDS_DIR = REPO_ROOT / "extensions" / "commands"

if str(REPO_ROOT) not in sys.path:
    sys.path.insert(0, str(REPO_ROOT))


COMMAND_FILES = sorted(
    path
    for path in COMMANDS_DIR.glob("*.py")
    if path.name != "__init__.py" and not path.name.startswith("_")
)


def _parse_module(path: Path) -> ast.Module:
    return ast.parse(path.read_text(encoding="utf-8"), filename=str(path))


def _load_module(path: Path):
    module_name = f"test_extcmd_{path.stem}"
    spec = importlib.util.spec_from_file_location(module_name, path)
    if spec is None or spec.loader is None:
        raise RuntimeError(f"Could not load module spec for {path}")
    module = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(module)
    return module


@pytest.mark.parametrize("path", COMMAND_FILES, ids=lambda p: p.name)
def test_command_module_has_only_allowed_top_level_functions(path: Path):
    tree = _parse_module(path)
    func_names = [node.name for node in tree.body if isinstance(node, (ast.FunctionDef, ast.AsyncFunctionDef))]
    assert func_names == ["handle", "register"], (
        f"{path.name}: top-level functions must be exactly ['handle', 'register'], got {func_names}"
    )


@pytest.mark.parametrize("path", COMMAND_FILES, ids=lambda p: p.name)
def test_command_module_has_no_top_level_classes(path: Path):
    tree = _parse_module(path)
    class_names = [node.name for node in tree.body if isinstance(node, ast.ClassDef)]
    assert not class_names, f"{path.name}: top-level classes are not allowed: {class_names}"


@pytest.mark.parametrize("path", COMMAND_FILES, ids=lambda p: p.name)
def test_command_module_source_has_no_forbidden_patterns(path: Path):
    source = path.read_text(encoding="utf-8")
    for snippet in FORBIDDEN_SOURCE_SNIPPETS:
        assert snippet not in source, f"{path.name}: forbidden pattern found: {snippet}"


@pytest.mark.parametrize("path", COMMAND_FILES, ids=lambda p: p.name)
def test_command_module_has_no_direct_system_state_import(path: Path):
    tree = _parse_module(path)
    bad_imports = []

    for node in ast.walk(tree):
        if isinstance(node, ast.ImportFrom) and node.module == "system.state":
            bad_imports.append("from system.state import ...")
        elif isinstance(node, ast.Import):
            for alias in node.names:
                if alias.name == "system.state":
                    bad_imports.append("import system.state")

    assert not bad_imports, f"{path.name}: forbidden global state import(s): {bad_imports}"


@pytest.mark.parametrize("path", COMMAND_FILES, ids=lambda p: p.name)
def test_command_module_register_returns_commanddef(path: Path):
    module = _load_module(path)
    cmd = module.register()
    assert isinstance(cmd, CommandDef), f"{path.name}: register() must return CommandDef"


@pytest.mark.parametrize("path", COMMAND_FILES, ids=lambda p: p.name)
def test_command_module_handler_signature_is_exact(path: Path):
    module = _load_module(path)
    assert callable(module.handle), f"{path.name}: handle must be callable"
    sig = inspect.signature(module.handle)
    params = list(sig.parameters.values())
    assert [p.name for p in params] == ["ctx", "args"], (
        f"{path.name}: handle signature must be exactly handle(ctx, args)"
    )
    assert all(p.kind in (inspect.Parameter.POSITIONAL_OR_KEYWORD,) for p in params), (
        f"{path.name}: handle parameters must be plain positional-or-keyword parameters"
    )


@pytest.mark.parametrize("path", COMMAND_FILES, ids=lambda p: p.name)
def test_commanddef_handler_points_to_module_handle(path: Path):
    module = _load_module(path)
    cmd = module.register()
    assert cmd.handler is module.handle, f"{path.name}: CommandDef.handler must point to handle"


@pytest.mark.parametrize("path", COMMAND_FILES, ids=lambda p: p.name)
def test_commanddef_metadata_is_present(path: Path):
    module = _load_module(path)
    cmd = module.register()
    assert isinstance(cmd.command, str) and cmd.command.strip(), f"{path.name}: command must be a non-empty string"
    assert isinstance(cmd.help_short, str) and cmd.help_short.strip(), f"{path.name}: help_short must be a non-empty string"
    assert isinstance(cmd.help_full, str) and cmd.help_full.strip(), f"{path.name}: help_full must be a non-empty string"


@pytest.mark.parametrize("path", COMMAND_FILES, ids=lambda p: p.name)
def test_handle_returns_only_3_tuple_shapes(path: Path):
    tree = _parse_module(path)
    handle_nodes = [node for node in tree.body if isinstance(node, ast.FunctionDef) and node.name == "handle"]
    assert len(handle_nodes) == 1, f"{path.name}: expected exactly one handle()"
    handle_node = handle_nodes[0]

    returns = [node for node in ast.walk(handle_node) if isinstance(node, ast.Return)]
    assert returns, f"{path.name}: handle() must contain at least one return"

    bad_returns = []
    for node in returns:
        value = node.value
        if not isinstance(value, ast.Tuple) or len(value.elts) != 3:
            bad_returns.append(ast.unparse(value) if value is not None else "None")

    assert not bad_returns, (
        f"{path.name}: every return in handle() must return a 3-tuple, bad returns: {bad_returns}"
    )


@pytest.mark.parametrize("path", COMMAND_FILES, ids=lambda p: p.name)
def test_handle_has_no_raise_statements(path: Path):
    tree = _parse_module(path)
    handle_nodes = [node for node in tree.body if isinstance(node, ast.FunctionDef) and node.name == "handle"]
    assert len(handle_nodes) == 1, f"{path.name}: expected exactly one handle()"
    handle_node = handle_nodes[0]

    raises = [node for node in ast.walk(handle_node) if isinstance(node, ast.Raise)]
    assert not raises, f"{path.name}: handle() must not raise for normal validation flow"


@pytest.mark.parametrize("path", COMMAND_FILES, ids=lambda p: p.name)
def test_handle_has_no_print_calls(path: Path):
    tree = _parse_module(path)
    bad_calls = []
    for node in ast.walk(tree):
        if isinstance(node, ast.Call) and isinstance(node.func, ast.Name) and node.func.id == "print":
            bad_calls.append(f"line {node.lineno}")
    assert not bad_calls, f"{path.name}: print() is forbidden: {', '.join(bad_calls)}"
