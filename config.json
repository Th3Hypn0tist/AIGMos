{
  "instance_name": "AIGMos-dev",
  "ip": "127.0.0.1",
  "group": "dev",
  "role": "local",
  "layout": "cs",
  "osc": {
    "in": {
      "bind_ip": "0.0.0.0",
      "port": 9000,
      "buffer": 65535
    }
  },
  "import": {
    "code": {
      "ignore": [
        "__pycache__",
        "*.pyc",
        "*.pyo",
        "*.sqlite",
        "*.db",
        ".DS_Store",
        ".gitignore",
        "Thumbs.db",
        ".git",
        ".venv",
        "node_modules",
        "*.zip",
        "import",
        "export",
        ".pytest_cache"
      ]
    }
  },
  "q": {
    "default": {
      "provider": "ollama",
      "base_url": "http://127.0.0.1:11434/api/chat",
      "health_url": "http://127.0.0.1:11434/api/tags",
      "api_key": "",
      "model": "qwen3:4b",
      "timeout_seconds": 3000,
      "stream_timeout_seconds": 20,
      "headers": {
        "Content-Type": "application/json"
      },
      "chat_message_tag": "message.content",
      "stream_message_tag": "message.content",
      "thinking_message_tag": "message.thinking",
      "think_payload": {
        "think": true
        },
      "nothink_payload": {}
      },
      
    "qwen": {
      "provider": "ollama",
      "base_url": "http://192.168.0.106:11434/api/chat",
      "health_url": "http://192.168.0.106:11434/api/tags",
      "api_key": "qwen3:30b",
      "model": "b",
      "timeout_seconds": 3000,
      "stream_timeout_seconds": 3000,
      "headers": {
        "Content-Type": "application/json"
      },
      "chat_message_tag": "message.content",
      "stream_message_tag": "message.content",
      "thinking_message_tag": "message.thinking"
    },
    "dummyt": {
      "provider": "dummyLLM",
      "base_url": "http://127.0.0.1:9001",
      "api_key": "dummyLLM-key",
      "model": "dummyLLM",
      "timeout_seconds": 15,
      "headers": {
