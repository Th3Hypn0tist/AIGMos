        "Content-Type": "application/json",
        "Authorization": "Bearer ..."
      },
      "chat_message_tag": "message"
    },
    "openai": {
      "provider": "openai",
      "base_url": "https://...",
      "api_key": "...",
      "model": "...",
      "timeout_seconds": 15,
      "headers": {
        "Content-Type": "application/json",
        "Authorization": "Bearer ..."
      },
      "chat_message_tag": "choices.0.message.content",
      "stream_message_tag": "choices.0.delta.content"
    }
  }
